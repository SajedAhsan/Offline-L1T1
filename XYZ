#include <bits/stdc++.h>
using namespace std;

void bfs(int start, vector<vector<int>>& adj, int n) {
    vector<bool> visited(n+1, false);
    queue<int> q;

    visited[start] = true;
    q.push(start);

    while (!q.empty()) {
        int node = q.front();
        q.pop();
        cout << node << " ";

        for (int child : adj[node]) {
            if (!visited[child]) {
                visited[child] = true;
                q.push(child);
            }
        }
    }
}

void dfs(int start, vector<vector<int>>& adj, int n) {
    vector<bool> visited(n+1, false);
    stack<int> st;
    st.push(start);

    while (!st.empty()) {
        int node = st.top();
        st.pop();

        if (!visited[node]) {
            cout << node << " ";
            visited[node] = true;

            // push children in reverse so left-most gets visited first
            for (int i = (int)adj[node].size()-1; i >= 0; i--) {
                int child = adj[node][i];
                if (!visited[child]) {
                    st.push(child);
                }
            }
        }
    }
}

int main() {
    int edges;
    cout << "Enter number of child-parent pairs: ";
    cin >> edges;

    vector<pair<int,int>> cp(edges);
    int maxNode = 0;
    set<int> children, parents;

    cout << "Enter pairs (child parent):\n";
    for (int i = 0; i < edges; i++) {
        int child, parent;
        cin >> child >> parent;
        cp[i] = {child, parent};
        maxNode = max({maxNode, child, parent});
        children.insert(child);
        parents.insert(parent);
    }

    vector<vector<int>> adj(maxNode+1);

    // build adjacency list (parent -> child)
    for (auto [child, parent] : cp) {
        adj[parent].push_back(child);
    }

    // root = node that never appears as a child
    int root = -1;
    for (int node : parents) {
        if (!children.count(node)) {
            root = node;
            break;
        }
    }

    if (root == -1) {
        cout << "No root found!\n";
        return 0;
    }

    cout << "Root detected: " << root << "\n";

    cout << "BFS traversal: ";
    bfs(root, adj, maxNode);
    cout << "\nDFS traversal: ";
    dfs(root, adj, maxNode);
    cout << "\n";

    return 0;
}



